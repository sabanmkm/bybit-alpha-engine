# ============================================================
# BYBIT LIVE BOT - ENVIRONMENT CONFIGURATION
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to `.env` (remove the .example suffix)
#   2. Fill in your Bybit API key and secret below
#   3. Set BYBIT_TESTNET=false for real trading, true for testnet
#   4. NEVER commit .env to git - it contains secrets!
# ============================================================

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=false
